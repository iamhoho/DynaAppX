<UserControl x:Class="DynaAppX.WpfControls.AccessCheckControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Converters="clr-namespace:DynaAppX.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <Converters:AccessColorConverter x:Key="AccessColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="Access Check Tool" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Selection Row -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="User:" VerticalAlignment="Center" Width="80" Margin="0,0,5,0"/>
            <ComboBox Grid.Column="1" x:Name="cboUser" Width="250" Margin="0,0,20,0" IsEditable="True"
                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      SelectionChanged="cboUser_SelectionChanged"
                      DropDownOpened="cboUser_DropDownOpened"/>

            <TextBlock Grid.Column="2" Text="Entity:" VerticalAlignment="Center" Width="80" Margin="0,0,5,0"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                <ComboBox x:Name="cboEntity" Width="150"
                          DisplayMemberPath="EntityDisplayName"
                          SelectionChanged="cboEntity_SelectionChanged"
                          DropDownOpened="cboEntity_DropDownOpened"
                          IsEnabled="False"/>
                <Button x:Name="btnLoadEntities" Content="Load Entities" Margin="5,0,0,0" Padding="10,2"
                        Click="btnLoadEntities_Click"/>
                <!-- Loading indicator -->
                <StackPanel x:Name="pnlLoading" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Loading..." VerticalAlignment="Center" Foreground="Gray"/>
                    <ProgressBar x:Name="prgLoading" Width="80" Height="14" Margin="5,0,0,0" IsIndeterminate="True"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="4" Text="Record:" VerticalAlignment="Center" Width="80" Margin="0,0,5,0"/>
            <ComboBox Grid.Column="5" x:Name="cboRecord" Width="250" IsEditable="True"
                      DisplayMemberPath="RecordName" SelectedValuePath="Id"
                      SelectionChanged="cboRecord_SelectionChanged"
                      DropDownOpened="cboRecord_DropDownOpened"/>
        </Grid>

        <!-- User Info Section -->
        <GroupBox Grid.Row="2" Header="User Info" Margin="10" Padding="10">
            <StackPanel>
                <TextBlock x:Name="txtUserName" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Roles: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <ItemsControl x:Name="lstRoles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Margin="2" Padding="5,2"
                                        Click="btnRole_Click" Tag="{Binding Id}"
                                        Background="#5cb85c" Foreground="White"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Teams: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <ItemsControl x:Name="lstTeams">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Margin="2" Padding="5,2"
                                        Click="btnTeam_Click" Tag="{Binding Id}"
                                        Background="#337ab7" Foreground="White"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Access Rights Section -->
        <GroupBox Grid.Row="3" Header="Record Access Rights" Margin="10" Padding="10">
            <ItemsControl x:Name="lstAccessRights">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3" Padding="10,5" CornerRadius="3"
                                Background="{Binding HasAccess, Converter={StaticResource AccessColorConverter}}">
                            <TextBlock Text="{Binding RightName}" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- Status -->
        <TextBlock Grid.Row="4" x:Name="txtStatus" Margin="10" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
