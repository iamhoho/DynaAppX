<UserControl x:Class="DynaAppX.WpfControls.InvokeFlowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Invoke Flow / Action" FontSize="20" FontWeight="Bold"
                   Foreground="Black" Margin="10"/>

        <!-- Flow Selection Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Flow:" VerticalAlignment="Center" Width="80" Foreground="Black"/>
            <ComboBox x:Name="cboFlow" Width="300" DisplayMemberPath="Name"
                      SelectionChanged="cboFlow_SelectionChanged" DropDownOpened="cboFlow_DropDownOpened"/>
            <TextBlock x:Name="txtFlowCategory" Text="" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>

            <TextBlock x:Name="lblRecord" Text="Record:" VerticalAlignment="Center" Width="80" Margin="20,0,5,0" Foreground="Black"/>
            <ComboBox x:Name="cboRecord" Width="250" IsEditable="True"
                      DisplayMemberPath="RecordName" SelectedValuePath="Id"
                      SelectionChanged="cboRecord_SelectionChanged"
                      DropDownOpened="cboRecord_DropDownOpened"/>

            <CheckBox x:Name="chkRawMode" Content="Raw Mode" Foreground="Black"
                      VerticalAlignment="Center" Margin="20,0,0,0"
                      Checked="chkRawMode_Changed" Unchecked="chkRawMode_Changed"/>
            <Button x:Name="btnInvoke" Content="Invoke" Padding="15,5" Margin="20,0,0,0"
                    Click="btnInvoke_Click" IsEnabled="False"
                    Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- Parameters Panel -->
        <Border Grid.Row="2" Background="#F0F0F0" Margin="10" Padding="10" CornerRadius="4">
            <StackPanel x:Name="pnlParameters">
                <TextBlock Text="Parameters:" Foreground="Black" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtNoParameters" Text="Select a flow to see parameters"
                           Foreground="Gray"/>
                <ItemsControl x:Name="lstParameters">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="{Binding Name}" Width="150" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtValue" Width="200"
                                         Text="{Binding Value, Mode=TwoWay}"
                                         IsEnabled="{Binding IsEnabled}"/>
                                <TextBlock Text="{Binding Type}" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="txtRawModeLabel" Text="Raw JSON:" Foreground="Black" Margin="0,10,0,5" Visibility="Collapsed"/>
                <TextBox x:Name="txtRawJson" Width="400" Height="80" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Invoke History -->
        <Grid Grid.Row="3" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Invoke History" Foreground="Black" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid Grid.Row="1" x:Name="dgHistory" AutoGenerateColumns="False"
                      Background="White" Foreground="Black" BorderBrush="#CCCCCC"
                      IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding InvokeDate, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="60"/>
                    <DataGridTextColumn Header="Request" Binding="{Binding RequestBody}" Width="*"/>
                    <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>