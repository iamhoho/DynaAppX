<UserControl x:Class="DynaAppX.WpfControls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Visibility="Collapsed">
        <!-- Semi-transparent dark overlay -->
        <Border Background="#CC1A1A2E" Opacity="0.95">
            <Border.Effect>
                <BlurEffect Radius="3"/>
            </Border.Effect>
        </Border>

        <!-- Centered content card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#252536" Offset="0"/>
                    <GradientStop Color="#1E1E2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00D4FF" Offset="0"/>
                    <GradientStop Color="#00FF88" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <Border.Effect>
                <DropShadowEffect Color="#00D4FF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel Margin="40,30">
                <!-- Spinning ring with glow -->
                <Grid Width="50" Height="50" HorizontalAlignment="Center">
                    <!-- Outer ring -->
                    <Ellipse Stroke="#00D4FF" StrokeThickness="3" StrokeDashArray="4,3" Opacity="0.3"/>
                    <!-- Inner spinning arc -->
                    <Ellipse x:Name="Spinner" StrokeThickness="3"
                             StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D4FF" Offset="0"/>
                                <GradientStop Color="#00FF88" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00FF88" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                        </Ellipse.Effect>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotation"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Loading text -->
                <TextBlock x:Name="txtMessage" Text="Loading..."
                           Foreground="#E0E0E0" FontFamily="Cascadia Code, Consolas"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,16,0,0"/>

                <!-- Animated dots -->
                <TextBlock x:Name="txtDots" Text="" Foreground="#00D4FF"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="13" HorizontalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <StringAnimationUsingKeyFrames Storyboard.TargetName="txtDots" Storyboard.TargetProperty="Text">
                                        <DiscreteStringKeyFrame KeyTime="0:0:0.0" Value=""/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:0.4" Value="."/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:0.8" Value=".."/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:1.2" Value="..."/>
                                    </StringAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>