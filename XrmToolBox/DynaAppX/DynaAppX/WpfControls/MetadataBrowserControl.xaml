<UserControl x:Class="DynaAppX.WpfControls.MetadataBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Metadata Browser" FontSize="24" FontWeight="Bold"
                       Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Open the CRM metadata browser to explore entity definitions, attributes, and relationships."
                       FontSize="14" Foreground="Gray" TextWrapping="Wrap" Width="500"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Open Entity Metadata Browser" Padding="15,10" Margin="10"
                        Click="btnOpenEntityMetadata_Click"
                        Background="#007ACC" Foreground="White" BorderThickness="0"/>
                <Button Content="Open General Metadata Browser" Padding="15,10" Margin="10"
                        Click="btnOpenMetadata_Click"
                        Background="#007ACC" Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <TextBlock Text="Note: Requires web resources to be published in your CRM environment."
                       FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>