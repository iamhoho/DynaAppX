<UserControl x:Class="DynaAppX.WpfControls.WelcomePageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="FeatureButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Welcome to DynaAppX"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="XrmToolBox Plugin for Dynamics 365"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <Border Background="#F0F0F0" CornerRadius="8" Padding="30" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Features" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,15"/>

                    <Button Content="AccessCheck - Check user permissions on records"
                            Style="{StaticResource FeatureButton}"
                            Click="BtnAccessCheck_Click"
                            Margin="0,5"/>
                    <Button Content="InvokeFlow - Execute workflows and actions"
                            Style="{StaticResource FeatureButton}"
                            Click="BtnInvokeFlow_Click"
                            Margin="0,5"/>
                    <Button Content="GodPage - View and edit entity records"
                            Style="{StaticResource FeatureButton}"
                            Click="BtnGodPage_Click"
                            Margin="0,5"/>
                    <Button Content="MetadataBrowser - Browse entity metadata"
                            Style="{StaticResource FeatureButton}"
                            Click="BtnMetadataBrowser_Click"
                            Margin="0,5"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Click a feature above to get started, or use the toolbar menu."
                       FontSize="12"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>